# FINNRI backend environment template.
# Copy to .env for local development. Keep real secrets out of Git.

# Required server settings.
PORT=8080
TZ_DEFAULT=Asia/Kolkata

# Required for browser clients. Comma-separated exact origins; do not use "*".
# A missing origin fails CORS, which the dashboard shows only as requests that
# never return. Production is https://finnri.app.
ALLOW_ORIGINS=http://localhost:3000,http://localhost:8081

# Optional legacy shared bearer for non-user-token internal routes.
AUTH_BEARER=
# App sessions expire after 7 days by default. Accepted range: 1-30.
AUTH_SESSION_TTL_DAYS=7
ADMIN_BOOTSTRAP_USER_IDS=
ADMIN_AUDIT_SALT=
USD_INR_RATE=88

# Required AI provider secret. Replace in .env; do not commit the real key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=gpt-4o-mini-transcribe
OPENAI_STATEMENT_MAX_OUTPUT_TOKENS=4000
OPENAI_MAX_OUTPUT_TOKENS=600
AI_PARSE_DISABLED=false
AI_UNPAID_MAX_VOICE_BYTES=524288
AI_FAILED_PARSE_COOLDOWN_THRESHOLD=5
AI_FAILED_PARSE_COOLDOWN_WINDOW_MINUTES=15
AI_FAILED_PARSE_COOLDOWN_MINUTES=10
AI_PROVIDER_FAILURE_THRESHOLD=5
AI_PROVIDER_CIRCUIT_BREAKER_SECONDS=120
AI_DAILY_COST_ALERT_USD_MICROS=0
AI_ABUSE_DAILY_CREDITS_THRESHOLD=500
AI_FREE_COST_PER_USER_ALERT_USD_MICROS=100000

# Required backend maintenance settings.
MAINTENANCE_JOBS_ENABLED=true
MAINTENANCE_INTERVAL_HOURS=24
ANONYMOUS_GUEST_RETENTION_DAYS=90

# Required proxy trust settings. Controls which upstream addresses may set
# X-Forwarded-For. Empty uses the private-range default. Set to "none" when the
# server is exposed directly to the internet.
TRUSTED_PROXIES=

# How many proxies stand between the client and this process. This, not
# TRUSTED_PROXIES, is what every per-client decision keys on: the rate-limit
# buckets, the guest trial grant, and the hashed IP in the admin audit log.
#
# 1 behind Railway, Fly, Render or a single nginx - the last entry in
# X-Forwarded-For is the one that proxy appended, and the only one a caller
# cannot write itself. 2 where a CDN sits in front of that. 0 for a process
# exposed directly, where the header must not be believed at all.
#
# Getting it wrong fails loudly in one direction only: too many hops and every
# caller shares a single bucket, which shows up at once as blanket 429s. Too
# few, and callers can be pooled together but never separated - so prefer to
# start at 1 and raise it only if traffic is being limited that should not be.
#
# Why it exists: relying on TRUSTED_PROXIES alone needs the platform's proxy
# range, and Railway's edge is neither in the private ranges nor documented.
# ClientIP() then resolved differently per request, every request opened its own
# bucket, and rate limiting was inert in production until 2026-09-10.
TRUSTED_PROXY_HOPS=1

# Required request safety limits.
REQUEST_TIMEOUT_SECONDS=30
RATE_LIMIT_RPS=5
RATE_LIMIT_BURST=10
# Payment providers deliver bursts from a small source-IP pool. Keep webhook
# traffic in its own, more generous bucket so ordinary billing reads cannot
# consume the provider's retry budget.
WEBHOOK_RATE_LIMIT_RPS=50
WEBHOOK_RATE_LIMIT_BURST=100
MAX_JSON_KB=64
MAX_UPLOAD_MB=15
MAX_TRANSCRIPT_CHARS=1000

# Required auth verification settings.
# Development only: when true, /v1/auth/otp/send includes dev_otp in the response.
# OTP sign-in is OFF for launch. Google and guest are the two doors in; email
# and SMS OTP ship together later. While this is false both /v1/auth/otp/send
# and /v1/auth/otp/verify answer 503, which also makes OTP_DEBUG_RESPONSE below
# inert - a deployed environment that leaves it on cannot hand out working
# sign-in codes, which is how production became exploitable.
AUTH_OTP_ENABLED=false

# Development only: when OTP_DEBUG_RESPONSE=true, OTP_DEV_CODE can force a static 6-digit OTP.
OTP_DEBUG_RESPONSE=false
OTP_DEV_CODE=
OTP_EXPIRES_MINUTES=10
# One code per address per cooldown. The auth rate limiter buckets by IP, which
# does nothing to stop one inbox being mailed from a rotating set of them.
OTP_RESEND_COOLDOWN_SECONDS=60
# Phone OTP stays off until an SMS provider exists. India SMS needs DLT
# template registration first; turning this on without one stores codes that
# nothing will deliver.
OTP_PHONE_CHANNEL_ENABLED=false

# --- Transactional email -----------------------------------------------------
# EMAIL_PROVIDER selects the driver: smtp | resend | log | (empty).
# Empty means no provider, and every OTP send then fails with otp_send_failed
# rather than claiming to have sent something. "log" prints the code to stdout
# and is for local development only - never set it in production.
EMAIL_PROVIDER=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Finnri
EMAIL_SEND_TIMEOUT_SECONDS=15

# EMAIL_PROVIDER=smtp. Works with Resend, Amazon SES, Brevo, Postmark, Mailgun
# and Gmail alike. SMTP_TLS_MODE is starttls (port 587), tls (implicit, port
# 465) or none (local capture servers only - it refuses to carry a password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=starttls

# EMAIL_PROVIDER=resend. One API key, no port or TLS decisions.
RESEND_API_KEY=
RESEND_BASE_URL=
CLAIM_TOKEN_EXPIRES_MINUTES=15

# Required for Google login. Comma-separated OAuth client IDs accepted as ID-token audiences.
# Include the web client ID used by finnri-web and the Expo/native client ID used by mobile.
GOOGLE_CLIENT_IDS=

# Required database connection settings. Replace DB_PASSWORD in .env.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=finnri
DB_SSLMODE=disable

# Required only when applying checked-in migrations with psql.
# Example format: postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=

# Optional machine access to /v1/admin for trusted scripts. Leave empty to
# require a real admin session for every admin request. This must NOT be the
# same value as AUTH_BEARER: the browser BFF sends AUTH_BEARER on every admin
# request, so reusing it would hand admin to anyone who can reach the console.
ADMIN_STATIC_TOKEN=

# --- Payments (Razorpay) -----------------------------------------------------
# The route is web checkout on finnri-web, not store billing: UPI carries no
# MDR where Play Billing takes 15%. Recorded in
# docs/PLANS_AND_CREDITS_PRICING_PLAN.md.
#
# checkout_enabled stays false on every plan until ALL THREE are set. Holding
# the API keys without the webhook secret would advertise a checkout whose
# payments could never be confirmed - money in, nothing granted.
#
# RAZORPAY_KEY_ID is publishable and is sent to the browser. The other two are
# secret and never leave the process.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Override only in tests, to point at a fake provider.
RAZORPAY_BASE_URL=
# Canonical origin of the web app. Production is https://finnri.app. The server
# builds both hosted checkout and split-invite URLs from this single value, so
# staging cannot mint production links and a missing origin fails closed.
WEB_BASE_URL=
