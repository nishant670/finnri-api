{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FinalEntry",
  "type": "object",
  "required": ["type", "amount", "currency", "account_id", "category", "date"],
  "properties": {
    "type": { "type": "string", "enum": ["expense", "income"] },
    "amount": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
      ]
    },
    "currency": { "type": "string", "const": "INR" },
    "source": { "type": "string", "enum": ["manual", "text", "voice"], "default": "manual" },
    "account_id": { "type": "integer", "minimum": 1 },
    "mode": {
      "type": "string",
      "description": "Optional when account_id identifies cash, bank, UPI, credit-card, debit-card, or wallet funding; the API derives the canonical mode. Required for an account of type other.",
      "enum": ["Cash", "Bank Account", "UPI", "Credit Card", "Wallets"]
    },
    "card_network": { "type": ["string", "null"], "enum": ["Visa", "Mastercard", "Amex", "Rupay", null] },
    "account_hint": { "type": ["string", "null"] },
    "category": { "type": "string", "enum": ["Food", "Travel", "Shopping", "Bills", "Family/Gifts", "Misc"] },
    "merchant": { "type": ["string", "null"] },
    "tag": { "type": ["string", "null"] },
    "refundable_amount": {
      "oneOf": [
        { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
        { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" },
        { "type": "null" }
      ]
    },
    "refund_expected_on": { "type": ["string", "null"], "format": "date" },
    "refund_reminder_at": { "type": ["string", "null"], "format": "date-time" },
    "refund_status": {
      "type": ["string", "null"],
      "enum": ["pending", "received", "written_off", null]
    },
    "notes": { "type": ["string", "null"] },
    "date": { "type": "string", "format": "date" },
    "time": { "type": ["string", "null"], "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$" },
    "source_text": { "type": "string" },
    "split": {
      "type": "object",
      "required": ["participants"],
      "properties": {
        "group_id": { "type": ["integer", "null"], "minimum": 1 },
        "group_name": { "type": "string" },
        "notes": { "type": "string" },
        "participants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["share_amount"],
            "properties": {
              "friend_id": { "type": "integer", "minimum": 1 },
              "friend": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" }
                },
                "additionalProperties": false
              },
              "share_amount": {
                "oneOf": [
                  { "type": "number", "exclusiveMinimum": 0, "multipleOf": 0.01 },
                  { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
                ]
              },
              "direction": { "type": "string", "enum": ["friend_owes_user", "user_owes_friend"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
