{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParsedDraftEntry",
  "type": "object",
  "required": [
    "stage",
    "source_text",
    "confidence",
    "needs_confirmation",
    "missing_fields",
    "clarifications"
  ],
  "properties": {
    "stage": {
      "type": "string",
      "enum": [
        "draft"
      ],
      "default": "draft"
    },
    "type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "expense",
        "income",
        null
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "refundable_amount": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "refund_expected_on": {
      "type": ["string", "null"],
      "format": "date"
    },
    "emi_tenure_months": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 360
    },
    "emi_rate_pct": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "default": "INR"
    },
    "mode": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Cash",
        "Bank Account",
        "UPI",
        "Credit Card",
        "Wallets",
        null
      ]
    },
    "card_network": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Visa",
        "Mastercard",
        "Amex",
        "Rupay",
        null
      ]
    },
    "account_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Food & Drinks",
        "Transport",
        "Travel",
        "Shopping",
        "Bills",
        "Entertainment",
        "Family/Gifts",
        "Misc",
        "Salary",
        "Freelance",
        "Interest",
        "Refund",
        "Other",
        null
      ]
    },
    "merchant": {
      "type": [
        "string",
        "null"
      ]
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "purpose_type": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "normal_spend",
        "investment",
        "lending",
        "refund",
        "reimbursable",
        "donation",
        "card_payment",
        null
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$"
    },
    "source_text": {
      "type": "string"
    },
    "confidence": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mode": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "category": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "date": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "merchant": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tag": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "type": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "account_hint": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "needs_confirmation": {
      "type": "object",
      "properties": {
        "title": {
          "type": "boolean"
        },
        "amount": {
          "type": "boolean"
        },
        "mode": {
          "type": "boolean"
        },
        "category": {
          "type": "boolean"
        },
        "date": {
          "type": "boolean"
        },
        "type": {
          "type": "boolean"
        },
        "merchant": {
          "type": "boolean"
        },
        "tag": {
          "type": "boolean"
        },
        "account_hint": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "clarifications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Concise questions to ask the user if key fields are ambiguous"
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["title", "amount", "type", "mode", "category", "date"]
      }
    },
    "recurring_candidate": {
      "type": ["boolean", "null"]
    },
    "subscription_candidate": {
      "type": ["object", "null"],
      "properties": {
        "name": {
          "type": ["string", "null"]
        },
        "merchant": {
          "type": ["string", "null"]
        },
        "category": {
          "type": ["string", "null"]
        },
        "amount": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "billing_interval": {
          "type": ["string", "null"],
          "enum": ["daily", "business_daily", "weekly", "biweekly", "monthly", "quarterly", "yearly", null]
        },
        "next_due_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "last_charged_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "reminder_days": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 30
        },
        "cancel_before_due": {
          "type": ["boolean", "null"]
        },
        "cancel_on_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "autopay": {
          "type": ["boolean", "null"]
        },
        "payment_mode": {
          "type": ["string", "null"],
          "enum": ["Cash", "Bank Account", "UPI", "Credit Card", "Wallets", null]
        },
        "notes": {
          "type": ["string", "null"]
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "name",
              "merchant",
              "category",
              "amount",
              "billing_interval",
              "next_due_date",
              "last_charged_date",
              "reminder_days",
              "cancel_before_due",
              "cancel_on_date",
              "autopay",
              "payment_mode",
              "notes"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "split_candidate": {
      "type": ["boolean", "null"]
    },
    "split_candidate_details": {
      "type": ["object", "null"],
      "properties": {
        "group_name": {
          "type": ["string", "null"]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["friend_name", "share_amount", "direction"],
            "properties": {
              "friend_name": {
                "type": ["string", "null"]
              },
              "share_amount": {
                "type": ["number", "null"],
                "minimum": 0
              },
              "direction": {
                "type": "string",
                "enum": ["friend_owes_user", "user_owes_friend"]
              }
            },
            "additionalProperties": false
          }
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["group_name", "participants", "friend_name", "friend_or_group", "share_amount", "direction"]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
